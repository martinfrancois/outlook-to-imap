<?xml version="1.0" encoding="UTF-8"?>
<!-- Global settings for this build, loaded by .mvn/maven.config; your own ~/.m2/settings.xml still
     applies on top. Every dependency comes from Maven Central. The Graph SDK and Flyway POMs declare
     further repositories that refuse anonymous requests, so the mirror sends all of them to Central. -->
<settings xmlns="http://maven.apache.org/SETTINGS/1.2.0">
    <mirrors>
        <mirror>
            <id>central</id>
            <mirrorOf>*</mirrorOf>
            <url>https://repo.maven.apache.org/maven2</url>
        </mirror>
    </mirrors>
</settings>
