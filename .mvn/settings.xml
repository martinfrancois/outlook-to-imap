<?xml version="1.0" encoding="UTF-8"?>
<!-- Without this mirror every build asks the Graph SDK's and Flyway's own repositories, which refuse anonymous requests, and logs a warning, see docs/adr/0019-resolve-every-dependency-from-maven-central.md
     Loaded as global settings, so a system mvn (not ./mvnw) skips its own conf/settings.xml; ~/.m2/settings.xml still applies. -->
<settings xmlns="http://maven.apache.org/SETTINGS/1.2.0">
    <mirrors>
        <mirror>
            <id>central</id>
            <mirrorOf>external:*</mirrorOf>
            <url>https://repo.maven.apache.org/maven2</url>
        </mirror>
    </mirrors>
</settings>
