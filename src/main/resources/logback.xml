<configuration>
    <!-- Containers collect stdout, so the console is the only appender. Nothing here logs tokens,
         passwords or message content: the code never passes them to a logger, and MSAL's
         personal-data logging stays off. -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd'T'HH:mm:ss.SSSXXX} %-5level %logger{0} - %msg%n</pattern>
        </encoder>
    </appender>

    <logger name="com.microsoft.aad.msal4j" level="WARN"/>
    <logger name="com.zaxxer.hikari" level="WARN"/>
    <logger name="org.flywaydb" level="WARN"/>

    <root level="${LOG_LEVEL:-INFO}">
        <appender-ref ref="CONSOLE"/>
    </root>
</configuration>
